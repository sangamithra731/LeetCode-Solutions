class Solution {
    public double findMaxAverage(int[] arr, int k) {
        double sum=0;
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        double avg=(sum/k);
        for(int i=k;i<arr.length;i++){
            sum=sum-arr[i-k];
            sum=sum+arr[i];
            double avg1=(sum/k);
            if(avg<avg1){
                avg=avg1;
            }
        }
        return avg;
    }
}
