class Solution {
    public int[] sortArrayByParity(int[] arr) {
         int[] a=new int[arr.length];
        int b=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]%2==0){
                a[b]=arr[i];
                b++;
            }
        }
        for(int i=0;i<arr.length;i++){
            if(arr[i]%2!=0){
                a[b]=arr[i];
                b++;
            }
        }   
        
       return a; 
    }
}
