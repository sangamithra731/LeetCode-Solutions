class Solution {
    public int largestAltitude(int[] gain) {
        int arr[]=new int[gain.length];
        int sum=0;
        for(int i=0;i<gain.length;i++){
            sum+=gain[i];
            arr[i]=sum;
        }
        int max=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]>max){
                max=arr[i];

            }

        }
        return max;
    }
}
