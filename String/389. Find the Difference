class Solution {
    public char findTheDifference(String s, String t) {

        char[] str1 = new char[s.length()];
        char[] str2 = new char[t.length()];

        for(int i = 0; i < s.length(); i++) {
            char ch1 = s.charAt(i);
            str1[i] = ch1;
        }

        for(int i = 0; i < t.length(); i++) {
            char ch2 = t.charAt(i);
            str2[i] = ch2;
        }

        Arrays.sort(str1);
        Arrays.sort(str2);

        for(int i = 0; i < str1.length; i++) {
            if(str1[i] != str2[i]) {
                return str2[i];
            }
        }

        return str2[str1.length];
    }
}
