class Solution {
    public boolean isAcronym(List<String> words, String s) {
        if(words.size()==s.length()){
            for(int i=0;i<s.length();i++){
                char ch=s.charAt(i);
                char ch1=words.get(i).charAt(0);
                if(ch!=ch1){
                   return false;
                }

            }
        }
        else{
            return false;
        }
        return true;
    }
}
