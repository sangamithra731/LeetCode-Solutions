class Solution {
    public String sortSentence(String s) {
        
        String[] str2=s.split(" ");
        String[] str=new String[str2.length];
        for(int i=0;i<str.length;i++){
            char ch=str2[i].charAt(str2[i].length()-1);
            int num = ch-'0';
            
        
            str[num - 1] = str2[i].substring(0, str2[i].length() - 1);
        }
        String result = String.join(" ", str);
        return result;
    }
}
