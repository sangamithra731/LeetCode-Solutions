class Solution {
    public String firstPalindrome(String[] words) {
       String str="";
       for(int i=0;i<words.length;i++){
        String og=words[i];
        String dup="";
        for(int j=words[i].length()-1;j>=0;j--){
            char ch=words[i].charAt(j);
            dup+=ch;
        }
        if(dup.equals(og)){
            return og;
        }
       }return str;
    }
}
