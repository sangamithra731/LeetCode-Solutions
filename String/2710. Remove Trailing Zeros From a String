class Solution {
    public String removeTrailingZeros(String num) {
      int a=0;
      for(int i=num.length()-1;i>=0;i--){
        char ch=num.charAt(i);
        if(ch=='0'){
            a++;
        }
        else{
            break;
        }
      }
      String str="";
      for(int i=0;i<num.length()-a;i++){
        char ch2=num.charAt(i);
        str+=ch2;
      }
      return str;
    }
}
